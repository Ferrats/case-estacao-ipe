<form class="booking-bar" data-booking-form>
  <div class="booking-field">
    <label for="entrada">Entrada</label>
    <input id="entrada" name="entrada" type="date" required />
  </div>
  <div class="booking-field">
    <label for="saida">Saída</label>
    <input id="saida" name="saida" type="date" required />
  </div>
  <div class="booking-field">
    <label for="hospedes">Hóspedes</label>
    <select id="hospedes" name="hospedes">
      <option>2 hóspedes</option>
      <option>3 hóspedes</option>
      <option>4 hóspedes</option>
      <option>5 hóspedes</option>
    </select>
  </div>
  <button class="button booking-submit" type="submit">Consultar disponibilidade</button>
  <p class="form-feedback" data-booking-feedback hidden></p>
</form>
